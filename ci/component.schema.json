{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "spec": {
      "type": "object",
      "properties": {
        "coreFunction": {
          "type": "object",
          "properties": {
            "dependentAPIs": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/dependentAPI"
              }
            },
            "exposedAPIs": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/exposedAPI"
              }
            },
            "publishedEvents": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "resources": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "apiType": {
                    "type": "string"
                  },
                  "apiSDO": {
                    "type": "string"
                  },
                  "hub": {
                    "type": "string"
                  },
                  "implementation": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "port": {
                    "type": "number"
                  },
                  "specification": {
                    "type": "string"
                  },
                  "developerUI": {
                    "type": "string"
                  }
                }
              }
            },
            "subscribedEvents": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "apiType": {
                    "type": "string"
                  },
                  "apiSDO": {
                    "type": "string"
                  },
                  "call-back": {
                    "type": "string"
                  },
                  "implementation": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "port": {
                    "type": "number"
                  },
                  "resources": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "specification": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "developerUI": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "required": [
            "dependentAPIs",
            "exposedAPIs"
          ]
        },
        "componentMetadata":{
          "type": "object",
          "properties" : {

            "id": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "publicationDate": {
              "type": ["string", "null"],
              "format": "date"
            },
            "status": {
              "type": "string"
            },
            "functionalBlock": {
              "type": "string"
            },
            "owners": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "name"
                ]
              }
            },
            "maintainers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "name"
                ]
              }
            },
            "eTOMs":{
              "type" : "array"
            },
            "functionalFrameworkFunctions":{
              "type" : "array"
            }
          },
          "required": [
              "name",
              "id",
              "description",
              "functionalBlock",
              "publicationDate",
              "version"
            ]
        },
        "managementFunction": {
          "type": "array"
        },
        "securityFunction": {
          "type": "array"
        }
      },
      "required": [
        "coreFunction",
        "componentMetadata"
      ]
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "definitions": {
    "exposedAPI": {
      "type": "object",
      "properties": {
        "apiType": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "apiSDO": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "implementation": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "developerUI": {
          "type": "string"
        },
        "version": {
          "type": "number"
        }
      },
      "required": ["id", "required"]
    },
    "dependentAPI": {
      "type": "object",
      "properties": {
        "apiType": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "apiSDO": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "version": {
          "type": "number"
        }
      },
      "required": ["id","required"]
    }
  }
}
