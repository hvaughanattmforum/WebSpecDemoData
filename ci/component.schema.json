{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "spec": {
      "type": "object",
      "properties": {
        "coreFunction": {
          "type": "object",
          "properties": {
            "dependentAPIs": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/dependentAPI"
              }
            },
            "exposedAPIs": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/exposedAPI"
              }
            },
            "publishedEvents": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/eventAPI"
              }
            },
            "subscribedEvents": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/eventAPI"
              }
            }
          },
          "required": [
            "exposedAPIs"
          ]
        },
        "componentMetadata":{
          "type": "object",
          "properties" : {

            "id": {
              "type": "string",
              "description": "TMF ODA Component identifier in the format TMFCXXX."
            },
            "description": {
              "type": "string",
              "description": "TMF ODA Component Description"
            },
            "name": {
              "type": "string",
              "description": "TMF ODA Component Name"
            },
            "version": {
              "type": "string",
              "description": "TMF ODA Component Version"
            },
            "publicationDate": {
              "type": ["string", "null"],
              "format": "date",
              "description": "TMF ODA Component publication date"
            },
            "status": {
              "type": "string"
            },
            "functionalBlock": {
              "type": "string",
              "description": "TMF ODA Component Name Functional Block"
            },
            "owners": {
              "type": "array",
              "description": "Owners is an optional list of the owners of the installed component.",
              "items": {
                "$ref": "#/definitions/contact"
              }
            },
            "maintainers": {
              "type": "array",
              "description": "Maintainers is an optional list of maintainers of the component. The maintainers in this list maintain the source code, images, and package for the component.",
              "items": {
                "$ref": "#/definitions/contact"
              }
            },
            "eTOMs":{
              "type" : "array"
            },
            "functionalFrameworkFunctions":{
              "type" : "array"
            }
          },
          "required": [
              "name",
              "id",
              "description",
              "functionalBlock",
              "publicationDate",
              "version"
            ]
        },
        "managementFunction": {
          "type": ["array", "object"]
        },
        "securityFunction": {
          "type": ["array", "object"]
        }
      },
      "required": [
        "coreFunction",
        "componentMetadata"
      ]
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "definitions": {
    "apiSpecification": {
      "type": "object",
      "properties": {
        "version": {
          "type": ["number", "string"]
        },
        "apiType": {
          "type": "string",
          "description": "The type of API specification. Currently only OpenAPI (swagger) and open-metrics (metrics) APIs are supported."
        },
        "url": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "The path to the root of the API"
        },
        "developerUI": {
          "type": "string",
          "description": "(optional) The path to the developer User Interface for the API"
        },
        "implementation": {
          "type": "string",
          "description": "The name of the service where the implementation of the API is found"
        },
        "port": {
          "type": "number",
          "description": "The port where the API is exposed"
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": ["version"]
    },
    "exposedAPI": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "Name of the API"
        },
        "apiSDO": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "specification": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/apiSpecification"
          }
        },

        "apiType": {
          "type": "string"
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "implementation": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "developerUI": {
          "type": "string"
        },
        "version": {
          "type": ["number", "string"]
        }
      },
      "required": ["id", "required"]
    },
    "dependentAPI": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "Name of the API that this component is dependent on"
        },
        "apiSDO": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "specification": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/apiSpecification"
          }
        },

        "apiType": {
          "type": "string"
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "version": {
          "type": ["number", "string"]
        }
      },
      "required": ["id","required"]
    },
    "eventAPI": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "array",
          "description": "Open APIs resources specified for the Component",
          "items": {
            "type": "string"
          }
        },
        "apiType": {
          "type": "string"
        },
        "apitype": {
          "type": "string"
        },
        "apiSDO": {
          "type": "string"
        },
        "hub": {
          "type": "string",
          "description": "The path for configuring the destination for the events"
        },
        "implementation": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "port": {
          "type": "number"
        },
        "specification": {
          "type": "string"
        },
        "developerUI": {
          "type": "string"
        },
        "call-back": {
          "type": "string",
          "description": "The path to call-back end-point for these events"
        }
      }
    },
    "contact": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Email is the email address."
        },
        "name": {
          "type": "string",
          "description": "Name is the descriptive name."
        },
        "url": {
          "type": "string",
          "description": "Website address of maintaining/owning organization."
        }
      },
      "required": [
        "email",
        "name"
      ]
    }
  }
}
